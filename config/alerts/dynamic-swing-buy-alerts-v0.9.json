{
  "schema_version": 1,
  "strategy": {
    "key": "dynamic_swing_buy_alerts",
    "version": "0.9",
    "name": "Dynamic swing buy alerts",
    "skill_version": "1.7.0"
  },
  "feature_calculation_version": "1.6.0",
  "decision_contract_version": "0.9",
  "universe": {
    "exchanges": ["XNAS", "XNYS"],
    "security_type": "CS",
    "exclude_otc": true,
    "exclude_industry_groups": ["Healthcare"],
    "minimum_price": 5,
    "minimum_market_cap": 100000000
  },
  "hard_thresholds": {
    "minimum_ttm_revenue_growth_pct": 40,
    "minimum_quarter_revenue_growth_pct": 40,
    "maximum_price_change_12w_pct": -20,
    "minimum_avg_dollar_volume_20d": 30000000
  },
  "market_regime": {
    "benchmark_ticker": "SPY",
    "moving_average_sessions": 50,
    "require_close_above_moving_average": true,
    "data_timing": "completed_session_only"
  },
  "trigger_model": {
    "source": "prior_session_high_20d",
    "above_high_pct": "0.1",
    "stop": "max(prior_low_20d, trigger - stop_atr_multiple * prior_atr_14)",
    "stop_atr_multiple": "2",
    "anchor_within_pct": "10",
    "break_below_trigger_pct": "10"
  },
  "labels": {
    "close_band_pct": "5",
    "buy_band_pct": "5",
    "buy_max_sessions_above": 3,
    "require_positive_rs_20d_vs_qqq": true,
    "research_max_age_days": 30
  },
  "tracking": {
    "max_sessions_outside_screen": 60,
    "no_progress_sessions": 30,
    "progress_within_pct": "10"
  },
  "blocking": {
    "max_share_count_yoy_pct": "15",
    "min_cash_runway_months": 12,
    "unknown_sic_blocks": true
  },
  "email": {
    "max_buy": 3,
    "max_close": 5,
    "max_recovering": 5,
    "collapse_unchanged_sessions": 5,
    "target_max_chars": 8000
  },
  "comparison_model": "daily-comparison-v1"
}
